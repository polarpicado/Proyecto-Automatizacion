{
  "name": "WF_SYNC_FILES_DETECT",
  "nodes": [
    {
      "parameters": {
        "url": "http://fastapi:8000/repository/files",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
