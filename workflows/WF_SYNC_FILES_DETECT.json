      ],
      "id": "22dbeaa9-b8ad-4d4d-af2f-89c7fea273f8",
      "name": "HTTP Request - Get Files"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all();\n\nlet files = [];\nfor (const item of input) {\n  const data = item.json;\n\n  if (Array.isArray(data)) {\n    files.push(...data);\n  } else if (Array.isArray(data.files)) {\n    files.push(...data.files);\n  } else if (Array.isArray(data.data)) {\n    files.push(...data.data);\n  } else if (data && data.name && data.url) {\n    files.push(data);\n  }\n}\n\nconst now = new Date().toISOString();\n\nreturn files.map((file) => {\n  const entityId = String(file.url || file.name);\n  const modifiedAt = file.modified_at || null;\n  const size = Number(file.size || 0);\n\n  return {\n    json: {\n      entity_type: 'file',\n      entity_id: entityId,\n      name: file.name || null,\n      original_name: file.original_name || null,\n      extension: file.extension || null,\n      source_url: file.url || null,\n      modified_at: modifiedAt,\n      size,\n      version_key: `${modifiedAt || ''}|${size}`,\n      snapshot_status: 'active',\n      last_seen_at: now,\n      raw: file\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -752
      ],
      "id": "354dee70-0f6a-4efd-af79-2c71168fa615",
      "name": "Code - Normalize Current Files"
    },
    {
      "parameters": {
        "jsCode": "const currentItems = $('Code - Normalize Current Files').all().map(i => i.json);\n\nconst previousItems = $('MongoDB - Load Previous File Snapshot')\n  .all()\n  .map(i => i.json)\n  .filter(i => i && i.entity_id);\n\nconst currentMap = new Map();\nconst previousMap = new Map();\n\nfor (const item of currentItems) {\n  currentMap.set(item.entity_id, item);\n}\n\nfor (const item of previousItems) {\n  previousMap.set(item.entity_id, item);\n}\n\nconst results = [];\n\nfor (const [entityId, current] of currentMap.entries()) {\n  const previous = previousMap.get(entityId);\n\n  if (!previous) {\n    results.push({\n      json: {\n        entity_type: 'file',\n        entity_id: entityId,\n        diff_type: 'created',\n        current,\n        previous: null\n      }\n    });\n    continue;\n  }\n\n  if (current.version_key !== previous.version_key) {\n    results.push({\n      json: {\n        entity_type: 'file',\n        entity_id: entityId,\n        diff_type: 'updated',\n        current,\n        previous\n      }\n    });\n  }\n}\n\nfor (const [entityId, previous] of previousMap.entries()) {\n  if (!currentMap.has(entityId)) {\n    results.push({\n      json: {\n        entity_type: 'file',\n        entity_id: entityId,\n        diff_type: 'deleted',\n        current: null,\n        previous\n      }\n    });\n  }\n}\n\nif (results.length === 0) {\n  return [\n    {\n      json: {\n        entity_type: 'file',\n        diff_type: 'no_changes'\n      }\n    }\n  ];\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -752
      ],
      "id": "563bc1a2-9315-4936-9827-a03eb4e6bff8",
      "name": "Code - Compare Current Vs Previous"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $input.item.json;\n\nif (row.diff_type === 'no_changes') {\n  return {\n    json: {\n      entity_type: 'file',\n      event_type: 'no_changes'\n    }\n  };\n}\n\nlet eventType = null;\nlet eventTs = new Date().toISOString();\nlet versionKey = null;\nlet payload = null;\n\nif (row.diff_type === 'created') {\n  eventType = 'file_created';\n  eventTs = row.current?.modified_at || eventTs;\n  versionKey = row.current?.version_key || null;\n  payload = row.current;\n}\n\nif (row.diff_type === 'updated') {\n  eventType = 'file_updated';\n  eventTs = row.current?.modified_at || eventTs;\n  versionKey = row.current?.version_key || null;\n  payload = {\n    current: row.current,\n    previous: row.previous\n  };\n}\n\nif (row.diff_type === 'deleted') {\n  eventType = 'file_deleted';\n  versionKey = row.previous?.version_key || null;\n  payload = row.previous;\n}\n\nreturn {\n  json: {\n    entity_type: 'file',\n    entity_id: row.entity_id,\n    event_type: eventType,\n    event_ts: eventTs,\n    version_key: versionKey,\n    correlation_key: `file|${row.entity_id}|${eventType}|${eventTs}`,\n    payload\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
