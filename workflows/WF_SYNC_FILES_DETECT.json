    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ev = $input.item.json;\n\nif (ev.event_type === 'file_created') {\n  const data = ev.payload;\n\n  return {\n    json: {\n      op: 'upsert',\n      entity_type: 'file',\n      entity_id: ev.entity_id,\n      version_key: ev.version_key,\n      status: 'active',\n      name: data.name,\n      original_name: data.original_name,\n      extension: data.extension,\n      source_url: data.source_url,\n      modified_at: data.modified_at,\n      size: data.size,\n      last_seen_at: new Date().toISOString(),\n      raw: data.raw\n    }\n  };\n}\n\nif (ev.event_type === 'file_updated') {\n  const data = ev.payload.current;\n\n  return {\n    json: {\n      op: 'upsert',\n      entity_type: 'file',\n      entity_id: ev.entity_id,\n      version_key: ev.version_key,\n      status: 'active',\n      name: data.name,\n      original_name: data.original_name,\n      extension: data.extension,\n      source_url: data.source_url,\n      modified_at: data.modified_at,\n      size: data.size,\n      last_seen_at: new Date().toISOString(),\n      raw: data.raw\n    }\n  };\n}\n\nif (ev.event_type === 'file_deleted') {\n  return {\n    json: {\n      op: 'delete',\n      entity_type: 'file',\n      entity_id: ev.entity_id\n    }\n  };\n}\n\nreturn {\n  json: {\n    op: 'ignore'\n  }\n};"
      },
