      "id": "3c7aeec0-f478-4c6f-ab37-2497599c46d3",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "jsCode": "const response = $('Leer Repo').first()?.json || {};\nconst files = Array.isArray(response.files) ? response.files : [];\nconst supportedExtensions = new Set(['.txt', '.md', '.json', '.csv', '.html', '.xml', '.log', '.docx', '.pdf']);\n\n// Mongo llega por input directo a este nodo\nconst previousDocs = $input.all().map(item => item.json).filter(doc => doc && doc.source_id);\n\nconst previousIndex = {};\nfor (const doc of previousDocs) {\n  previousIndex[doc.source_id] = doc;\n}\n\nconst currentIndex = {};\nconst output = [];\n\n// Archivos actuales → normalizar + detectar nuevos/modificados\nfor (const file of files) {\n  const extension = String(file.extension || '').toLowerCase();\n\n  const normalized = {\n    source_id: `repo:${file.name}`,\n    file_name: file.name,\n    original_name: file.original_name || file.name,\n    extension,\n    modified_at: file.modified_at || null,\n    size: Number(file.size || 0),\n    version_key: `${file.modified_at || ''}:${Number(file.size || 0)}`,\n    download_url: `http://fastapi:8000${file.url || ''}`,\n    relative_url: file.url || '',\n    is_supported: supportedExtensions.has(extension),\n  };\n\n  if (!normalized.is_supported) continue;\n\n  currentIndex[normalized.source_id] = normalized;\n  const previous = previousIndex[normalized.source_id];\n\n  if (!previous) {\n    output.push({\n      json: {\n        ...normalized,\n        sync_action: 'upsert',\n        change_type: 'new',\n      },\n    });\n    continue;\n  }\n\n  if (previous.version_key !== normalized.version_key) {\n    output.push({\n      json: {\n        ...normalized,\n        sync_action: 'upsert',\n        change_type: 'modified',\n      },\n    });\n  }\n}\n\n// Detectar eliminados\nfor (const [sourceId, previous] of Object.entries(previousIndex)) {\n  if (!currentIndex[sourceId]) {\n    output.push({\n      json: {\n        source_id: previous.source_id,\n        file_name: previous.file_name,\n        original_name: previous.original_name,\n        extension: previous.extension,\n        modified_at: previous.modified_at,\n        size: previous.size,\n        version_key: previous.version_key,\n        download_url: previous.download_url,\n        relative_url: previous.relative_url,\n        sync_action: 'delete',\n        change_type: 'deleted',\n      },\n    });\n  }\n}\n\n// Debug temporal\nif (output.length === 0) {\n  return [{\n    json: {\n      debug: true,\n      message: 'No hubo upserts ni deletes',\n      current_files_count: files.length,\n      previous_index_keys: Object.keys(previousIndex),\n    },\n  }];\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
