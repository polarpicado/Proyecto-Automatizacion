      "parameters": {
        "jsCode": "const file = $json.files?.[0];\n\nif (!file || !file.text) {\n  return {\n    json: {\n      ...$json,\n      should_index: false,\n      skip_reason: 'no_text'\n    }\n  };\n}\n\nconst text = String(file.text || '').trim();\n\nreturn {\n  json: {\n    ...$json,\n    extracted_name: file.name,\n    extracted_type: file.type,\n    extracted_characters: file.characters,\n    content: text,\n    should_index: Boolean(text)\n  }\n};"
      },
