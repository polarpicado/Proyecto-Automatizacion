      "id": "35f87cb7-c6d0-4028-841e-24ed986c1497",
      "name": "MongoDB - Load Previous Solution Snapshot",
      "alwaysOutputData": true,
      "credentials": {
        "mongoDb": {
          "id": "OVY43bDYYcqEdR6l",
          "name": "MongoDB account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const currentItems = $('Code - Normalize Current Solutions').all().map(i => i.json);\n\nconst previousItems = $('MongoDB - Load Previous Solution Snapshot')\n  .all()\n  .map(i => i.json)\n  .filter(i => i && i.entity_id);\n\nconst currentMap = new Map();\nconst previousMap = new Map();\n\nfor (const item of currentItems) {\n  currentMap.set(item.entity_id, item);\n}\n\nfor (const item of previousItems) {\n  previousMap.set(item.entity_id, item);\n}\n\nconst results = [];\n\nfor (const [entityId, current] of currentMap.entries()) {\n  const previous = previousMap.get(entityId);\n\n  if (!previous) {\n    results.push({\n      json: {\n        entity_type: 'solution',\n        entity_id: entityId,\n        diff_type: 'created',\n        current,\n        previous: null\n      }\n    });\n    continue;\n  }\n\n  if (current.version_key !== previous.version_key) {\n    results.push({\n      json: {\n        entity_type: 'solution',\n        entity_id: entityId,\n        diff_type: 'updated',\n        current,\n        previous\n      }\n    });\n  }\n}\n\nfor (const [entityId, previous] of previousMap.entries()) {\n  if (!currentMap.has(entityId)) {\n    results.push({\n      json: {\n        entity_type: 'solution',\n        entity_id: entityId,\n        diff_type: 'deleted',\n        current: null,\n        previous\n      }\n    });\n  }\n}\n\n// 🔥 CLAVE: evitar flujo muerto\nif (results.length === 0) {\n  return [\n    {\n      json: {\n        entity_type: 'solution',\n        diff_type: 'no_changes'\n      }\n    }\n  ];\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        -752
      ],
      "id": "212f8179-b8be-4591-b55c-61d0a1a87612",
      "name": "Code - Compare Current Vs Previous Solutions"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $input.item.json;\n\nlet eventType = null;\nlet eventTs = new Date().toISOString();\nlet versionKey = null;\nlet payload = null;\n\nif (row.diff_type === 'created') {\n  eventType = 'solution_created';\n  eventTs = row.current?.updated_at || row.current?.created_at || eventTs;\n  versionKey = row.current?.version_key || null;\n  payload = row.current;\n}\n\nif (row.diff_type === 'updated') {\n  eventType = 'solution_updated';\n  eventTs = row.current?.updated_at || eventTs;\n  versionKey = row.current?.version_key || null;\n  payload = {\n    current: row.current,\n    previous: row.previous\n  };\n}\n\nif (row.diff_type === 'deleted') {\n  eventType = 'solution_deleted';\n  versionKey = row.previous?.version_key || null;\n  payload = row.previous;\n}\n\nreturn {\n  json: {\n    entity_type: 'solution',\n    entity_id: row.entity_id,\n    event_type: eventType,\n    event_ts: eventTs,\n    version_key: versionKey,\n    correlation_key: `solution|${row.entity_id}|${eventType}|${eventTs}`,\n    payload\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
