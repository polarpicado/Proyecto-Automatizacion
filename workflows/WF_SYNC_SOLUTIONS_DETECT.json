    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Code - Preparar Contexto Solución').first().json;\nconst data = $input.item.json;\n\nconst htmlRaw =\n  data.descripcion_html ||\n  data.description_html ||\n  '';\n\nconst cleanText = htmlRaw\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<\\/p>/gi, '\\n\\n')\n  .replace(/<[^>]+>/g, '')\n  .replace(/\\n\\s*\\n/g, '\\n\\n')\n  .trim();\n\nconst title =\n  data.titulo ||\n  data.title ||\n  ctx.title ||\n  '';\n\nconst folder =\n  data.carpeta ||\n  data.folder ||\n  ctx.folder ||\n  '';\n\nconst content = [\n  title ? `# ${title}` : '',\n  folder ? `**Carpeta:** ${folder}` : '',\n  cleanText\n].filter(Boolean).join('\\n\\n');\n\nreturn {\n  json: {\n    content,\n    metadata: {\n      source_id: ctx.source_id,\n      entity_type: 'solution',\n      title,\n      file_name: null,\n      version_key: ctx.version_key,\n      document_origin: 'solutions_api',\n      updated_at: ctx.updated_at,\n      status: 'active'\n    }\n  }\n};"
