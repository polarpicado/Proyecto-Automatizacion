    {
      "parameters": {
        "jsCode": "const input = $input.all();\n\nlet solutions = [];\nfor (const item of input) {\n  const data = item.json;\n\n  if (Array.isArray(data)) {\n    solutions.push(...data);\n  } else if (Array.isArray(data.items)) {\n    solutions.push(...data.items);\n  } else if (Array.isArray(data.solutions)) {\n    solutions.push(...data.solutions);\n  } else if (Array.isArray(data.data)) {\n    solutions.push(...data.data);\n  } else if (data && data._id) {\n    solutions.push(data);\n  }\n}\n\nconst now = new Date().toISOString();\n\nreturn solutions.map((s) => {\n  return {\n    json: {\n      entity_type: 'solution',\n      entity_id: String(s._id),\n      title: s.titulo || null,\n      folder: s.carpeta || null,\n      description_html: s.descripcion_html || '',\n      created_at: s.created_at || null,\n      updated_at: s.updated_at || null,\n      version_key: String(s.updated_at || ''),\n      snapshot_status: 'active',\n      last_seen_at: now,\n      raw: s\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -752
      ],
      "id": "5f00b055-cd30-4a36-acff-9457168e520c",
      "name": "Code - Normalize Current Solutions"
