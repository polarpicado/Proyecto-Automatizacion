    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ev = $input.item.json;\n\nif (ev.event_type === 'solution_created') {\n  const data = ev.payload;\n\n  return {\n    json: {\n      op: 'upsert',\n      entity_type: 'solution',\n      entity_id: ev.entity_id,\n      version_key: ev.version_key,\n      status: 'active',\n      title: data.title,\n      folder: data.folder,\n      description_html: data.description_html,\n      created_at: data.created_at,\n      updated_at: data.updated_at,\n      last_seen_at: new Date().toISOString(),\n      raw: data.raw\n    }\n  };\n}\n\nif (ev.event_type === 'solution_updated') {\n  const data = ev.payload.current;\n\n  return {\n    json: {\n      op: 'upsert',\n      entity_type: 'solution',\n      entity_id: ev.entity_id,\n      version_key: ev.version_key,\n      status: 'active',\n      title: data.title,\n      folder: data.folder,\n      description_html: data.description_html,\n      created_at: data.created_at,\n      updated_at: data.updated_at,\n      last_seen_at: new Date().toISOString(),\n      raw: data.raw\n    }\n  };\n}\n\nif (ev.event_type === 'solution_deleted') {\n  return {\n    json: {\n      op: 'delete',\n      entity_type: 'solution',\n      entity_id: ev.entity_id\n    }\n  };\n}\n\nreturn {\n  json: {\n    op: 'ignore'\n  }\n};"
      },
