    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Code - Preparar Contexto Solución Updated').first().json;\nconst data = $input.item.json;\n\n// --------- LIMPIEZA HTML → TEXTO ---------\nconst htmlRaw =\n  data.descripcion_html ||\n  data.description_html ||\n  '';\n\nconst cleanText = htmlRaw\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<\\/p>/gi, '\\n\\n')\n  .replace(/<[^>]+>/g, '') // remove all tags\n  .replace(/\\n\\s*\\n/g, '\\n\\n')\n  .trim();\n\n// --------- CAMPOS ---------\nconst title =\n  data.titulo ||\n  data.title ||\n  ctx.title ||\n  '';\n\nconst folder =\n  data.carpeta ||\n  data.folder ||\n  ctx.folder ||\n  '';\n\n// --------- MARKDOWN FINAL ---------\nconst content = [\n  title ? `# ${title}` : '',\n  folder ? `**Carpeta:** ${folder}` : '',\n  cleanText\n].filter(Boolean).join('\\n\\n');\n\n// --------- OUTPUT ---------\nreturn {\n  json: {\n    content,\n    metadata: {\n      source_id: ctx.source_id,\n      entity_type: 'solution',\n      title,\n      file_name: null,\n      version_key: ctx.version_key,\n      document_origin: 'solutions_api',\n      updated_at: ctx.updated_at,\n      status: 'active'\n    }\n  }\n};"
      },
